<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Conversation"
             xmlns:c="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Conversation.ToolCallDetailView"
             x:DataType="vm:ToolCallDetailViewModel">

  <Border Background="{StaticResource BgBase}" Padding="12" CornerRadius="8" MinWidth="400" MaxWidth="700"
          BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
          Focusable="True" KeyDown="OnKeyDown">
    <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Input" Foreground="{StaticResource TextMuted}" FontSize="11" />
        <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="6" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding RawInputJson}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Output" Foreground="{StaticResource TextMuted}" FontSize="11" />
        <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="6" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding RawOutputJson}" Foreground="{StaticResource TextSuccessBright}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Copy input" Command="{Binding CopyInputCommand}" FontSize="12" Padding="8,4" />
        <Button Content="Copy output" Command="{Binding CopyOutputCommand}" FontSize="12" Padding="8,4" />
        <TextBlock Text="{Binding CopyStatus}" Foreground="{StaticResource TextSuccess}" FontSize="12" VerticalAlignment="Center"
                   IsVisible="{Binding CopyStatus, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="Esc to close" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
