<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Conversation"
             xmlns:views="clr-namespace:Agent.Acp.Client.AvaloniaApp.Views.Conversation"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:Converters="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Conversation.ChatView"
             x:DataType="vm:ChatViewModel">

  <Border Background="{StaticResource BgPrimary}" Padding="12">
    <DockPanel LastChildFill="True">
      <!-- Removed "Chat (WIP)" header per Opus review -->

      <Border Background="{StaticResource BgPrimary}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
              BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
              IsVisible="{Binding HasTranscriptItems, Converter={x:Static Converters:BoolConverters.Not}}">
        <TextBlock Text="Send a message to get started" Foreground="{StaticResource TextMuted}" FontStyle="Italic" />
      </Border>

      <ScrollViewer Name="TranscriptScroller" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Transcript}" Margin="0,0,0,8">
          <ItemsControl.Styles>
            <Style Selector="ItemsControl > ContentPresenter">
              <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
          </ItemsControl.Styles>

          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:IntentGroupViewModel">
              <views:IntentGroupView />
            </DataTemplate>

            <DataTemplate DataType="sys:String">
              <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="10"
                      BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
              </Border>
            </DataTemplate>


            <DataTemplate DataType="vm:UserMessageViewModel">
              <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="10"
                      BorderBrush="{StaticResource AccentPrimary}" BorderThickness="1">
                <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:ToolCallRowViewModel">
              <Border Background="{StaticResource BgSecondary}" CornerRadius="6" Padding="8"
                      BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:ReasoningBlockViewModel">
              <Border Background="{StaticResource BgBase}" CornerRadius="6" Padding="8"
                      BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <Expander IsExpanded="{Binding IsExpanded}">
                  <Expander.Header>
                    <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource TextMuted}" FontStyle="Italic" />
                  </Expander.Header>

                  <Border Background="{StaticResource BgTertiary}" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                          BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextSecondary}" FontStyle="Italic" TextWrapping="Wrap" />
                  </Border>
                </Expander>
              </Border>
            </DataTemplate>

            <DataTemplate DataType="vm:StreamingIndicatorViewModel">
              <Border Background="#111318" CornerRadius="6" Padding="8"
                      BorderBrush="#2A3040" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="▍" Foreground="#6B7280" FontFamily="Consolas" />
                  <TextBlock Text="{Binding Label}" Foreground="#6B7280" FontStyle="Italic" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
