<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Conversation"
             xmlns:c="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Conversation.ComposerView"
             x:DataType="vm:ComposerViewModel">

  <Border Background="{StaticResource BgBase}" Padding="10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
    <StackPanel Spacing="6">
      <TextBox Name="ComposerTextBox" Text="{Binding Text}" AcceptsReturn="True" MinHeight="40" MaxHeight="120"
               Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" KeyDown="OnComposerKeyDown" />

      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Spacing="2">
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource TextError}"
                     IsVisible="{Binding Error, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />

          <TextBlock Text="Ctrl+Enter to send • Esc closes tool details"
                     Foreground="{StaticResource TextMuted}" FontSize="11" />
        </StackPanel>

        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                Background="{StaticResource AccentPrimary}" Foreground="{StaticResource TextOnAccent}" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
