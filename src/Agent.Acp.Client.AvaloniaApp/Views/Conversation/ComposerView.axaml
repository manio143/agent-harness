<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Conversation"
             xmlns:c="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Conversation.ComposerView"
             x:DataType="vm:ComposerViewModel">

  <Border Background="#0B0D10" Padding="10" BorderBrush="#2A3040" BorderThickness="0,1,0,0">
    <StackPanel Spacing="6">
      <TextBox Name="ComposerTextBox" Text="{Binding Text}" AcceptsReturn="True" MinHeight="40" MaxHeight="120"
               Background="#1A1D24" Foreground="#E6E6E6" KeyDown="OnComposerKeyDown" />

      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding Error}" Foreground="#FFB4B4"
                   IsVisible="{Binding Error, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />

        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                Background="#3B82F6" Foreground="#FFFFFF" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
