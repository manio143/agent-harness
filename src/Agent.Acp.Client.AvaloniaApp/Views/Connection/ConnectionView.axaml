<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Connection"
             xmlns:c="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Connection.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

  <Border Padding="24">
    <StackPanel Spacing="14" MaxWidth="760">
      <TextBlock Text="Connect to ACP agent (stdio)" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="This client currently launches an ACP agent process and talks over line-delimited JSON-RPC on stdio." Opacity="0.7" TextWrapping="Wrap"/>

      <StackPanel Spacing="6">
        <TextBlock Text="Command" />
        <TextBox Text="{Binding Command}" PlaceholderText="dotnet" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Arguments" />
        <TextBox Text="{Binding Arguments}" PlaceholderText="run --project src/Agent.Server" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Working directory" />
        <TextBox Text="{Binding WorkingDirectory}" />
      </StackPanel>

      <Border Background="#2A1515" CornerRadius="6" Padding="10" IsVisible="{Binding Error, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" Foreground="#FFB4B4" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Connect" Command="{Binding ConnectCommand}" />
        <Button Content="Settings" IsEnabled="False" />
      </StackPanel>

      <TextBlock Text="Next: session/list → session/new → session/prompt" Opacity="0.6" />
    </StackPanel>
  </Border>
</UserControl>
