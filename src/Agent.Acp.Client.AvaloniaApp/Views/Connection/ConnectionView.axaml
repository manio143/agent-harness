<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Agent.Acp.Client.AvaloniaApp.ViewModels.Connection"
             xmlns:c="clr-namespace:Agent.Acp.Client.AvaloniaApp.Converters"
             mc:Ignorable="d"
             x:Class="Agent.Acp.Client.AvaloniaApp.Views.Connection.ConnectionView"
             x:DataType="vm:ConnectionViewModel">

  <Border Padding="20" Background="{StaticResource BgPrimary}">
    <StackPanel Spacing="12" MaxWidth="600">
      <TextBlock Text="Connect to ACP agent" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
      <TextBlock Text="Launch an ACP agent process (stdio JSON-RPC)." Foreground="{StaticResource TextMuted}" FontSize="12" />

      <StackPanel Spacing="4">
        <TextBlock Text="Command" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        <TextBox Text="{Binding Command}" PlaceholderText="dotnet" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}"
                 BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Arguments" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        <TextBox Text="{Binding Arguments}" PlaceholderText="run --project src/Agent.Server -c Release"
                 Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Working directory" Foreground="{StaticResource TextSecondary}" FontSize="12" />
        <TextBox Text="{Binding WorkingDirectory}" Background="{StaticResource BgSecondary}" Foreground="{StaticResource TextPrimary}"
                 BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" />
      </StackPanel>

      <CheckBox IsChecked="{Binding ContinueLastSession}" Content="Continue last session (server replay)"
                Foreground="{StaticResource TextSecondary}" FontSize="12" />

      <Border Background="{StaticResource BgErrorBanner}" CornerRadius="4" Padding="8" BorderBrush="{StaticResource BorderError}" BorderThickness="1"
              IsVisible="{Binding Error, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource TextError}" FontSize="12" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Connect" Command="{Binding ConnectCommand}" Background="{StaticResource AccentPrimary}" Foreground="#FFFFFF" Padding="12,6" />
        <Button Content="Settings" IsEnabled="False" Padding="12,6" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
